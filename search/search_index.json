041e\u0433\u043e\u043d\u044c\u00bb     \u2605\u2605\u2605\u2605\u2605     &gt; \u041a\u043b\u0430\u0441\u0441\u043d\u044b\u0439 \u044d\u043a\u0440\u0430\u043d. \u041b\u0435\u0433\u043a\u043e \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0437\u0430 \u043f\u0430\u0440\u0443 \u043c\u0438\u043d\u0443\u0442, \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 4K \u043d\u0430 \u0432\u044b\u0441\u043e\u0442\u0435.</p> </li> <li> <p>\u041c\u0430\u0440\u0438\u044f \u0418\u0432\u0430\u043d\u043e\u0432\u0430 \u2014 \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u0431\u0430\u0440\u0438\u0441\u0442\u0430 \u043a\u043e\u0444\u0435\u0439\u043d\u0438 \u00ab\u0417\u0435\u0440\u043d\u043e\u00bb     \u2605\u2605\u2605\u2605\u2605     &gt; \u041f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u0441\u044f \u0443\u0436\u0435 3 \u043c\u0435\u0441\u044f\u0446\u0430, \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c. \u041f\u0435\u0440\u0441\u043e\u043d\u0430\u043b \u0441\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0437\u0430 \u0441\u0435\u043a\u0443\u043d\u0434\u0443, \u044d\u043a\u0440\u0430\u043d \u043e\u0447\u0435\u043d\u044c \u043b\u0435\u0433\u043a\u0438\u0439 \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u043a\u0435.</p> </li> <li> <p>\u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u0421\u043e\u043a\u043e\u043b\u043e\u0432 \u2014 \u0430\u0440\u0442-\u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430 \u00ab\u041f\u0430\u043d\u043e\u0440\u0430\u043c\u0430\u00bb     \u2605\u2605\u2605\u2605\u2605     &gt; \u0411\u0440\u0430\u043b\u0438 \u0432 \u0430\u0440\u0435\u043d\u0434\u0443 \u043d\u0430 \u043c\u0435\u0441\u044f\u0446 \u2014 \u043e\u0441\u0442\u0430\u043b\u0438\u0441\u044c \u043e\u0447\u0435\u043d\u044c \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u044b \u0438 \u0432 \u0438\u0442\u043e\u0433\u0435 \u0440\u0435\u0448\u0438\u043b\u0438 \u0432\u044b\u043a\u0443\u043f\u0438\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u044c \u0432 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c!</p> </li> <li> <p>\u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u0430 \u041c\u043e\u0440\u043e\u0437\u043e\u0432\u0430 \u2014 \u0445\u043e\u0437\u044f\u0439\u043a\u0430 \u043a\u0430\u0444\u0435 \u00ab\u0422\u0435\u043f\u043b\u043e\u00bb     \u2605\u2605\u2605\u2605\u2605     &gt; \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0438 \u0440\u0435\u0430\u043b\u044c\u043d\u0430\u044f \u0437\u0430\u0431\u043e\u0442\u0430 \u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435. \u0410\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0443 \u0441 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f\u043c\u0438 \u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0441\u0442\u0438 \u043e\u0447\u0435\u043d\u044c \u0443\u0434\u043e\u0431\u043d\u043e \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044c \u0433\u0438\u0431\u043a\u0438\u0439 \u043a\u043e\u0440\u043f\u0443\u0441.</p> </li> <li> <p>\u0410\u043b\u0435\u043a\u0441\u0435\u0439 \u041d\u0438\u043a\u0438\u0442\u0438\u043d \u2014 \u0448\u0435\u0444-\u043f\u043e\u0432\u0430\u0440 \u0433\u0430\u0441\u0442\u0440\u043e\u0431\u0430\u0440\u0430 \u00ab\u0421\u0432\u043e\u0438\u00bb     \u2605\u2605\u2605\u2605\u2605     &gt; \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u044e \u0432\u0441\u0435\u043c \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u0442\u043e\u0440\u0430\u043c! \u0413\u043e\u0441\u0442\u0438 \u0438 \u0444\u0443\u0434\u0431\u043b\u043e\u0433\u0435\u0440\u044b \u0432 \u0432\u043e\u0441\u0442\u043e\u0440\u0433\u0435 \u043e\u0442 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u043e\u0439 \u043a\u0430\u043c\u0435\u0440\u044b.</p> </li> <li> <p>\u041e\u043b\u044c\u0433\u0430 \u0421\u043c\u0438\u0440\u043d\u043e\u0432\u0430 \u2014 \u0432\u043b\u0430\u0434\u0435\u043b\u0438\u0446\u0430 \u043a\u043e\u043d\u0434\u0438\u0442\u0435\u0440\u0441\u043a\u043e\u0439 \u00ab\u042d\u043a\u043b\u0435\u0440\u00bb     \u2605\u2605\u2605\u2605\u2606     &gt; \u042d\u043a\u0440\u0430\u043d \u0441\u0443\u043f\u0435\u0440, \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0430 \u0447\u0435\u0442\u043a\u0430\u044f, \u043d\u043e \u043a\u0443\u0440\u044c\u0435\u0440 \u043f\u0440\u0438\u0435\u0445\u0430\u043b \u043d\u0430 20 \u043c\u0438\u043d\u0443\u0442 \u043f\u043e\u0437\u0436\u0435 \u043e\u0433\u043e\u0432\u043e\u0440\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0412 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0441\u0435 \u043e\u0442\u043b\u0438\u0447\u043d\u043e.</p> </li> <li> <p>\u0421\u0435\u0440\u0433\u0435\u0439 \u0412\u043e\u043b\u043a\u043e\u0432 \u2014 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0449\u0438\u0439 \u043f\u0438\u0446\u0446\u0435\u0440\u0438\u0435\u0439 \u00ab\u041f\u0435\u0447\u044c\u00bb     \u2605\u2605\u2605\u2605\u2605     &gt; \u041e\u043a\u0443\u043f\u0438\u043b\u0441\u044f \u0437\u0430 \u043f\u0430\u0440\u0443 \u043d\u0435\u0434\u0435\u043b\u044c \u0430\u0440\u0435\u043d\u0434\u044b! \u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b\u0438 \u0442\u0440\u0435\u0445 \u0444\u0443\u0434\u0431\u043b\u043e\u0433\u0435\u0440\u043e\u0432, \u0438 \u0432\u0435\u0447\u0435\u0440\u043d\u044f\u044f \u043f\u043e\u0441\u0430\u0434\u043a\u0430 \u0437\u0430\u043c\u0435\u0442\u043d\u043e \u0432\u044b\u0440\u043e\u0441\u043b\u0430.</p> </li> <li> <p>\u041d\u0430\u0442\u0430\u043b\u044c\u044f \u0411\u0435\u043b\u043e\u0432\u0430 \u2014 \u043e\u0441\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0430 \u0432\u0435\u0433\u0430\u043d-\u043a\u0430\u0444\u0435 \u00ab\u0420\u043e\u0441\u0442\u043e\u043a\u00bb     \u2605\u2605\u2605\u2605\u2605     &gt; \u041e\u0447\u0435\u043d\u044c \u043b\u0435\u0433\u043a\u0438\u0439 \u0438 \u0433\u0438\u0431\u043a\u0438\u0439, \u0432 \u0441\u043b\u043e\u0436\u0435\u043d\u043d\u043e\u043c \u0432\u0438\u0434\u0435 \u0441\u043e\u0432\u0441\u0435\u043c \u043d\u0435 \u043c\u0435\u0448\u0430\u0435\u0442 \u043d\u0430 \u0441\u0442\u043e\u0439\u043a\u0435.</p> </li> <li> <p>\u0410\u0440\u0442\u0435\u043c \u0417\u0430\u0439\u0446\u0435\u0432 \u2014 \u043c\u0435\u043d\u0435\u0434\u0436\u0435\u0440 \u0441\u0442\u0435\u0439\u043a-\u0445\u0430\u0443\u0441\u0430 \u00ab\u041f\u0440\u0430\u0439\u043c\u00bb     \u2605\u2605\u2605\u2605\u2606     &gt; \u041e\u0442\u043b\u0438\u0447\u043d\u043e\u0435 \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0430. \u0425\u043e\u0442\u0435\u043b\u043e\u0441\u044c \u0431\u044b \u0432\u0438\u0434\u0435\u0442\u044c \u0432 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u0435 \u0447\u0435\u0445\u043e\u043b \u0431\u043e\u043b\u0435\u0435 \u0442\u0435\u043c\u043d\u043e\u0433\u043e \u0446\u0432\u0435\u0442\u0430, \u043d\u043e \u043f\u043e \u0440\u0430\u0431\u043e\u0442\u0435 \u043d\u0430\u0440\u0435\u043a\u0430\u043d\u0438\u0439 \u043d\u0435\u0442.</p> </li> </ul> <p>\u041e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043e\u0442\u0437\u044b\u0432 \u2192</p>"},{"location":"specs/","title":"\u0422\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438","text":"<p>\u041c\u043e\u0434\u0435\u043b\u044c: <code>FlexScreen FS-1</code></p> <p></p> <p>\u0424\u043b\u0430\u0433\u043c\u0430\u043d\u0441\u043a\u0438\u0439 \u0433\u0438\u0431\u043a\u0438\u0439 \u0434\u0438\u0441\u043f\u043b\u0435\u0439, \u0441\u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u0434\u043b\u044f \u0443\u0434\u043e\u0431\u043d\u043e\u0439 \u0441\u044a\u0435\u043c\u043a\u0438 \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0430 \u0432 \u043a\u0430\u0444\u0435 \u0438 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430\u0445.</p>"},{"location":"specs/#_2","title":"\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b","text":"\u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0430 \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0414\u0438\u0430\u0433\u043e\u043d\u0430\u043b\u044c \u044d\u043a\u0440\u0430\u043d\u0430 27\" (68,6 \u0441\u043c) \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435 4K UHD (3840\u00d72160) \u0441 \u0430\u043d\u0442\u0438\u0431\u043b\u0438\u043a\u043e\u0432\u044b\u043c \u043f\u043e\u043a\u0440\u044b\u0442\u0438\u0435\u043c \u0412\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u0430\u044f \u043a\u0430\u043c\u0435\u0440\u0430 1080p, 60 FPS \u0441 \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u044b\u043c \u0430\u0432\u0442\u043e\u0444\u043e\u043a\u0443\u0441\u043e\u043c \u0413\u0438\u0431\u043a\u0438\u0439 \u043a\u043e\u0440\u043f\u0443\u0441 \u0418\u0437\u0433\u0438\u0431 \u0434\u043e 180\u00b0 \u0441 \u043d\u0430\u0434\u0435\u0436\u043d\u043e\u0439 \u0444\u0438\u043a\u0441\u0430\u0446\u0438\u0435\u0439 \u0444\u043e\u0440\u043c\u044b (\u043a\u043e\u043c\u043f\u043e\u0437\u0438\u0442\u043d\u044b\u0439 \u0441\u043f\u043b\u0430\u0432) \u0412\u0435\u0441 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 1,8 \u043a\u0433 \u0418\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u044b \u0438 \u0441\u0432\u044f\u0437\u044c USB-C, HDMI, Wi-Fi 6, Bluetooth 5.2"},{"location":"specs/#_3","title":"\u041f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u043c\u043e\u0434\u0435\u043b\u0438","text":"<ul> <li> <p> \u0413\u0438\u0431\u043a\u0438\u0439 \u044d\u043a\u0440\u0430\u043d</p> <p>\u0423\u0434\u043e\u0431\u0441\u0442\u0432\u043e \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0432 \u043b\u044e\u0431\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u2014 \u043e\u0442 \u0431\u0430\u0440\u043d\u043e\u0439 \u0441\u0442\u043e\u0439\u043a\u0438 \u0434\u043e \u0431\u0430\u043d\u043a\u0435\u0442\u043d\u043e\u0433\u043e \u0441\u0442\u043e\u043b\u0430.</p> </li> <li> <p> \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u0432\u0435\u0431-\u043a\u0430\u043c\u0435\u0440\u0430</p> <p>\u0410\u0432\u0442\u043e\u0444\u043e\u043a\u0443\u0441 60 FPS \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u0443\u044e \u0447\u0435\u0442\u043a\u043e\u0441\u0442\u044c \u0431\u043b\u044e\u0434 \u0431\u0435\u0437 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0448\u0442\u0430\u0442\u0438\u0432\u0430.</p> </li> <li> <p> \u0412\u044b\u0441\u043e\u043a\u043e\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435</p> <p>\u0421\u043e\u0447\u043d\u0430\u044f \u0446\u0432\u0435\u0442\u043e\u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0430 \u0438 \u0430\u043d\u0442\u0438\u0431\u043b\u0438\u043a\u043e\u0432\u043e\u0435 \u043f\u043e\u043a\u0440\u044b\u0442\u0438\u0435 \u0434\u043b\u044f \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u0430\u0434\u0440\u0430 \u043f\u0440\u0438 \u043b\u044e\u0431\u043e\u043c \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0438.</p> </li> </ul>"},{"location":"specs/#_4","title":"\u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u0432\u0438\u0434\u0435\u043e\u043e\u0431\u0437\u043e\u0440","text":"<p>\u041e\u0446\u0435\u043d\u0438\u0442\u0435 \u0440\u0430\u0431\u043e\u0442\u0443 \u0433\u0438\u0431\u043a\u043e\u0433\u043e \u044d\u043a\u0440\u0430\u043d\u0430 \u0438 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u043e\u0439 \u043a\u0430\u043c\u0435\u0440\u044b \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430.</p> <p>\u0421\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043e\u0431\u0437\u043e\u0440 \u25b6\ufe0f \u041e\u0444\u043e\u0440\u043c\u0438\u0442\u044c \u0430\u0440\u0435\u043d\u0434\u0443 \u0438\u043b\u0438 \u043f\u043e\u043a\u0443\u043f\u043a\u0443 \u2192</p>"}]}